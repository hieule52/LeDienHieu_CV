<!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->
<section id="hero" class="hero-section bg-noise" aria-label="Hero introduction">
  <!-- Background dot grid -->
  <div class="hero-bg-grid" aria-hidden="true"></div>
  <!-- Ambient gradient glow -->
  <div class="hero-bg-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-grid">
      <!-- Content Column -->
      <div class="hero-content">
        <div class="fade-up">
          <div class="availability-badge" aria-label="<%= t.hero.badge %>">
            <span class="availability-dot" aria-hidden="true"></span>
            <%= t.hero.badge %>
          </div>
        </div>

        <div class="fade-up" style="transition-delay:80ms">
          <p class="hero-greeting"><%= t.hero.greeting %></p>
        </div>

        <div class="fade-up" style="transition-delay:160ms">
          <h1 class="hero-name"><%= person.name %></h1>
        </div>

        <div class="fade-up" style="transition-delay:240ms">
          <p class="hero-title">
            <span id="hero-typing"
              data-roles='<%= JSON.stringify(roles) %>'
              aria-label="<%= roles[0] %>"
            ><%= roles[0] %></span><span class="cursor" aria-hidden="true"></span>
          </p>
        </div>

        <div class="fade-up" style="transition-delay:320ms">
          <p class="hero-description"><%- t.hero.description %></p>
        </div>

        <div class="hero-actions fade-up" style="transition-delay:400ms">
          <a href="#projects" class="btn btn-primary btn-lg" aria-label="<%= t.hero.btnProjects %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <%= t.hero.btnProjects %>
          </a>
          <a href="<%= person.cvUrl %>" class="btn btn-secondary btn-lg" download aria-label="<%= t.hero.btnCv %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <%= t.hero.btnCv %>
          </a>
        </div>

        <div class="hero-socials fade-up" style="transition-delay:480ms">
          <a href="<%= person.github %>" class="hero-social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <div class="hero-social-divider" aria-hidden="true"></div>
          <a href="mailto:<%= person.email %>" class="hero-social-link" aria-label="Email <%= person.name %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Email
          </a>
          <div class="hero-social-divider" aria-hidden="true"></div>
          <a href="tel:<%= person.phone %>" class="hero-social-link" aria-label="Call <%= person.phone %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.39 2 2 0 0 1 3.62 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <%= person.phone %>
          </a>
        </div>
      </div>

      <!-- Profile Photo Visual Column -->
      <div class="hero-visual fade-in" style="transition-delay:150ms">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="profile-card-frame">
          <div class="profile-card-header">
            <div class="terminal-dots">
              <span class="terminal-dot red"></span>
              <span class="terminal-dot yellow"></span>
              <span class="terminal-dot green"></span>
            </div>
            <span class="profile-tag-label">&lt;LDH /&gt;</span>
          </div>

          <!-- Real Profile Image -->
          <div class="profile-img-container">
            <img
              src="/images/profile.png"
              alt="<%= t.hero.profileAlt %>"
              class="profile-img"
              loading="eager"
              fetchpriority="high"
              width="450"
              height="550"
            />
            <div class="profile-overlay-gradient"></div>
            <!-- Bottom floating chips -->
            <div class="profile-floating-info">
              <div class="profile-chip dev">
                <span class="chip-dot"></span>
                <span><%= t.hero.profileBadge %></span>
              </div>
            </div>
          </div>

          <div class="profile-card-footer">
            <div class="profile-stat-item">
              <span class="profile-stat-label">B.Sc. IT</span>
              <span class="profile-stat-val">Software Design</span>
            </div>
            <div class="profile-stat-divider"></div>
            <div class="profile-stat-item">
              <span class="profile-stat-label">Language</span>
              <span class="profile-stat-val">APTIS B1</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
