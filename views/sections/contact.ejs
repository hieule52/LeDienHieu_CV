<!-- ═══════════════════════════════ CONTACT / DIRECT CHANNELS ═══════════════════════════════ -->
<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-header fade-up">
      <p class="section-label" aria-hidden="true"><%= t.contact.label %></p>
      <h2 id="contact-title" class="section-title"><%= t.contact.title %></h2>
      <p class="section-subtitle">
        <%= t.contact.subtitle %>
      </p>
    </div>

    <!-- Direct Contact Hub Cards -->
    <div class="contact-hub-grid fade-up" style="transition-delay: 80ms;">
      <!-- Phone Card -->
      <div class="card card-hoverable contact-hub-card">
        <div class="contact-hub-icon phone" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.39 2 2 0 0 1 3.62 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="contact-hub-info">
          <p class="contact-hub-label">Phone / Zalo</p>
          <p class="contact-hub-val"><%= person.phone %></p>
          <p class="contact-hub-desc"><%= t.contact.phoneDesc %></p>
        </div>
        <a href="tel:<%= person.phone %>" class="btn btn-primary btn-sm contact-hub-btn" aria-label="Call <%= person.phone %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.39 2 2 0 0 1 3.62 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <%= t.contact.btnCall %>
        </a>
      </div>

      <!-- Email Card -->
      <div class="card card-hoverable contact-hub-card">
        <div class="contact-hub-icon email" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div class="contact-hub-info">
          <p class="contact-hub-label">Email</p>
          <p class="contact-hub-val"><%= person.email %></p>
          <p class="contact-hub-desc"><%= t.contact.emailDesc %></p>
        </div>
        <a href="mailto:<%= person.email %>" class="btn btn-primary btn-sm contact-hub-btn" aria-label="Email <%= person.email %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <%= t.contact.btnEmail %>
        </a>
      </div>

      <!-- GitHub Card -->
      <div class="card card-hoverable contact-hub-card">
        <div class="contact-hub-icon github" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        </div>
        <div class="contact-hub-info">
          <p class="contact-hub-label">GitHub Profile</p>
          <p class="contact-hub-val">github.com/<%= person.githubUsername %></p>
          <p class="contact-hub-desc"><%= t.contact.githubDesc %></p>
        </div>
        <a href="<%= person.github %>" class="btn btn-primary btn-sm contact-hub-btn" target="_blank" rel="noopener noreferrer" aria-label="Visit GitHub <%= person.github %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          <%= t.contact.btnGithub %>
        </a>
      </div>
    </div>

    <!-- Prominent CV Download Banner -->
    <div class="card cv-banner-card fade-up" style="transition-delay: 150ms; margin-top: var(--space-2xl);">
      <div class="cv-banner-content">
        <div class="cv-banner-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div class="cv-banner-text">
          <p class="cv-banner-tag"><%= t.contact.resumeTitle %></p>
          <h3 class="cv-banner-title">Lê Diên Hiếu &mdash; CV PDF</h3>
          <p class="cv-banner-desc"><%= t.contact.resumeDesc %></p>
        </div>
      </div>
      <div class="cv-banner-action">
        <a href="<%= person.cvUrl %>" class="btn btn-primary btn-lg" download aria-label="<%= t.contact.btnDownload %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <%= t.contact.btnDownload %>
        </a>
      </div>
    </div>

  </div>
</section>
