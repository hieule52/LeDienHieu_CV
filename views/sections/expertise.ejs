<!-- ═══════════════════════════════ EXPERTISE ═══════════════════════════════ -->
<section id="expertise" class="section" aria-labelledby="expertise-title">
  <div class="container">
    <div class="section-header fade-up">
      <p class="section-label" aria-hidden="true"><%= t.expertise.label %></p>
      <h2 id="expertise-title" class="section-title"><%= t.expertise.title %></h2>
      <p class="section-subtitle">
        <%= t.expertise.subtitle %>
      </p>
    </div>

    <div class="expertise-grid">

      <!-- 01 — Software & Web Development -->
      <article class="card card-hoverable expertise-card dev fade-up" style="transition-delay:80ms" aria-label="<%= t.expertise.card1.title %>">
        <p class="expertise-number">01</p>
        <div class="expertise-icon dev" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </div>
        <h3 class="expertise-title"><%= t.expertise.card1.title %></h3>
        <ul class="expertise-list" role="list">
          <% t.expertise.card1.items.forEach(function(item) { %>
            <li class="expertise-item"><%= item %></li>
          <% }); %>
        </ul>
        <div class="tags-grid" style="margin-top:var(--space-lg)">
          <span class="badge badge-dev">Next.js</span>
          <span class="badge badge-dev">PHP</span>
          <span class="badge badge-dev">Python</span>
          <span class="badge badge-dev">Node.js</span>
          <span class="badge badge-dev">JavaScript</span>
        </div>
      </article>

      <!-- 02 — IT Helpdesk & Technical Support -->
      <article class="card card-hoverable expertise-card it fade-up" style="transition-delay:160ms" aria-label="<%= t.expertise.card2.title %>">
        <p class="expertise-number">02</p>
        <div class="expertise-icon it" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M8.46 8.46a5 5 0 0 0 0 7.07"/></svg>
        </div>
        <h3 class="expertise-title"><%= t.expertise.card2.title %></h3>
        <p style="font-size:var(--text-xs);color:var(--text-muted);font-family:var(--font-mono);margin-bottom:var(--space-md)"><%= t.expertise.card2.subtitle %></p>
        <ul class="expertise-list" role="list">
          <% t.expertise.card2.items.forEach(function(item) { %>
            <li class="expertise-item"><%= item %></li>
          <% }); %>
        </ul>
        <div class="tags-grid" style="margin-top:var(--space-lg)">
          <span class="badge badge-it">Windows</span>
          <span class="badge badge-it">User Support</span>
          <span class="badge badge-it">Troubleshooting</span>
        </div>
      </article>

      <!-- 03 — PC Hardware -->
      <article class="card card-hoverable expertise-card hw fade-up" style="transition-delay:240ms" aria-label="<%= t.expertise.card3.title %>">
        <p class="expertise-number">03</p>
        <div class="expertise-icon hw" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
        </div>
        <h3 class="expertise-title"><%= t.expertise.card3.title %></h3>
        <p style="font-size:var(--text-xs);color:var(--text-muted);font-family:var(--font-mono);margin-bottom:var(--space-md)"><%= t.expertise.card3.subtitle %></p>
        <ul class="expertise-list" role="list">
          <% t.expertise.card3.items.forEach(function(item) { %>
            <li class="expertise-item"><%= item %></li>
          <% }); %>
        </ul>
        <div class="tags-grid" style="margin-top:var(--space-lg)">
          <span class="badge badge-hw">Build PC</span>
          <span class="badge badge-hw">Hardware Basics</span>
          <span class="badge badge-hw">Maintenance</span>
        </div>
      </article>

    </div>

    <!-- Tagline -->
    <div class="fade-up" style="text-align:center;margin-top:var(--space-3xl)">
      <p style="font-family:var(--font-mono);font-size:var(--text-sm);color:var(--text-muted)">
        <%= t.expertise.tagline %>
      </p>
    </div>
  </div>
</section>
