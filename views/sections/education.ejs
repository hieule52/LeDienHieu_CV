<!-- ═══════════════════════════════ EDUCATION ═══════════════════════════════ -->
<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <div class="section-header fade-up">
      <p class="section-label" aria-hidden="true"><%= t.education.label %></p>
      <h2 id="education-title" class="section-title"><%= t.education.title %></h2>
    </div>

    <div class="education-grid">
      <!-- Timeline -->
      <div class="fade-up">
        <div class="timeline" role="list">

          <!-- Degree -->
          <div class="timeline-item" role="listitem">
            <p class="timeline-date">Academic</p>
            <h3 class="timeline-title"><%= t.education.degreeTitle %></h3>
            <p class="timeline-subtitle"><%= t.education.degreeMajor %></p>
            <p class="timeline-body">
              <%= t.education.degreeDesc %>
            </p>
          </div>

          <!-- English -->
          <div class="timeline-item" role="listitem">
            <p class="timeline-date">Language Certification</p>
            <h3 class="timeline-title"><%= t.education.aptisTitle %></h3>
            <p class="timeline-subtitle"><%= t.education.aptisSub %></p>
            <p class="timeline-body">
              <%= t.education.aptisDesc %>
            </p>
          </div>

        </div>
      </div>

      <!-- Highlight card -->
      <div class="fade-up" style="transition-delay:150ms">
        <div class="card" style="padding:var(--space-xl)">
          <p style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--color-primary);text-transform:uppercase;letter-spacing:0.12em;margin-bottom:var(--space-lg)"><%= t.education.academicFocus %></p>

          <div style="display:flex;flex-direction:column;gap:var(--space-lg)">
            <div>
              <p style="font-size:var(--text-xs);color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:var(--space-sm)"><%= t.education.coreSubjects %></p>
              <div class="tags-grid">
                <span class="tag">Object-Oriented Programming</span>
                <span class="tag">Software Design</span>
                <span class="tag">Data Structures</span>
                <span class="tag">Database Systems</span>
                <span class="tag">Web Development</span>
                <span class="tag">Algorithms</span>
                <span class="tag">Operating Systems</span>
                <span class="tag">Computer Networks</span>
              </div>
            </div>

            <div class="divider"></div>

            <div>
              <p style="font-size:var(--text-xs);color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:var(--space-sm)"><%= t.education.readiness %></p>
              <ul style="display:flex;flex-direction:column;gap:var(--space-sm)">
                <% t.education.readinessItems.forEach(function(item) { %>
                  <li class="it-check-item">
                    <span class="it-check-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <%= item %>
                  </li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
