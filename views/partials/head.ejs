<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <!-- Mark JS as available immediately — used by CSS for progressive animation enhancement -->
  <script>document.documentElement.classList.add('js-ready');</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />


  <!-- Primary Meta -->
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>" />
  <% if (typeof meta.keywords !== 'undefined') { %>
  <meta name="keywords" content="<%= meta.keywords %>" />
  <% } %>
  <meta name="author" content="Lê Diên Hiếu" />
  <meta name="robots" content="index, follow" />

  <!-- Canonical -->
  <% if (typeof meta.url !== 'undefined') { %>
  <link rel="canonical" href="<%= meta.url %>" />
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= meta.title %>" />
  <meta property="og:description" content="<%= meta.description %>" />
  <% if (typeof meta.url !== 'undefined') { %><meta property="og:url" content="<%= meta.url %>" /><% } %>
  <% if (typeof meta.image !== 'undefined') { %><meta property="og:image" content="<%= meta.image %>" /><% } %>
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Lê Diên Hiếu Portfolio" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= meta.title %>" />
  <meta name="twitter:description" content="<%= meta.description %>" />
  <% if (typeof meta.image !== 'undefined') { %><meta name="twitter:image" content="<%= meta.image %>" /><% } %>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/variables.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/components.css" />
  <link rel="stylesheet" href="/css/responsive.css" />

  <!-- JSON-LD Structured Data -->
  <% if (typeof person !== 'undefined') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "<%= person.name %>",
    "jobTitle": "Software Developer & IT Support",
    "email": "<%= person.email %>",
    "telephone": "<%= person.phone %>",
    "url": "<%= typeof meta.url !== 'undefined' ? meta.url : '' %>",
    "sameAs": [
      "<%= person.github %>"
    ],
    "knowsAbout": ["Software Development", "Web Development", "IT Support", "PC Hardware"]
  }
  </script>
  <% } %>
</head>
<body class="loading-locked">
  <!-- ═══════════════════════════════ MODERN 5S LOADER ═══════════════════════════════ -->
  <div id="app-preloader" class="preloader-overlay" aria-hidden="true">
    <div class="preloader-background-glow"></div>
    <div class="preloader-card">
      <!-- Animated Logo Badge -->
      <div class="preloader-logo-wrap">
        <div class="preloader-logo-ring"></div>
        <div class="preloader-logo-ring outer"></div>
        <span class="preloader-logo-text">&lt;HIEU<span class="dot">.</span>DEV<span class="slash">/&gt;</span></span>
      </div>

      <!-- Live Terminal / Status Stream -->
      <div class="preloader-terminal-box">
        <div class="preloader-terminal-header">
          <span class="p-dot red"></span>
          <span class="p-dot yellow"></span>
          <span class="p-dot green"></span>
          <span class="preloader-sys-title">SYSTEM_INIT // v2.6.0</span>
        </div>
        <div class="preloader-console-lines" id="preloader-logs">
          <div class="p-line active"><span class="p-arrow">➜</span> <span class="p-cmd">INITIALIZING_CORE_ENGINE...</span></div>
        </div>
      </div>

      <!-- Modern Cyberpunk Progress Bar -->
      <div class="preloader-progress-section">
        <div class="preloader-progress-info">
          <span class="preloader-status-text" id="preloader-status">BOOTING ENVIRONMENT</span>
          <span class="preloader-percent" id="preloader-pct">0%</span>
        </div>
        <div class="preloader-track">
          <div class="preloader-bar" id="preloader-fill"></div>
          <div class="preloader-light-streak"></div>
        </div>
      </div>

      <div class="preloader-subtext">Portfolio · Software Engineer & IT Support Specialist</div>
    </div>
  </div>

  <!-- Skip Navigation -->
  <a href="#main-content" class="skip-nav">Skip to main content</a>
