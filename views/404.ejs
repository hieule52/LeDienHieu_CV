<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="error-page container">
    <div class="error-code">404</div>
    <h1 class="error-title">Route Not Found</h1>
    <div class="error-terminal-line">
      <span class="t-prompt">$</span> curl -I https://hieu.dev<span class="t-error"><%= typeof path !== 'undefined' ? path : '/not-found' %></span> &rarr; HTTP/1.1 404 Not Found
    </div>
    <p class="error-message">
      The page you're looking for doesn't exist, has been moved, or the link might be broken.
    </p>
    <a href="/" class="btn btn-primary btn-lg">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Back to Home
    </a>
  </div>
</main>

